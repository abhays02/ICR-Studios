{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:icr-bank:synthetic:cheque:1.0.0",
  "title": "CHEQUE business fields (draft permits null; final review validates completion)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "payee": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "cheque_date": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500,
      "format": "date"
    },
    "amount_words": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "amount": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500,
      "pattern": "^\\d{1,12}\\.\\d{2}$"
    },
    "currency": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500,
      "enum": [
        "INR",
        null
      ]
    },
    "cheque_number": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "crossed": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "declaration_date": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500,
      "format": "date"
    },
    "signature_present": {
      "type": [
        "boolean",
        "null"
      ]
    }
  },
  "required": [
    "payee",
    "cheque_date",
    "amount_words",
    "amount",
    "currency",
    "cheque_number",
    "crossed",
    "declaration_date",
    "signature_present"
  ]
}
