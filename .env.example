# Documentation only: never place real credentials in this tracked file.
# Generate a private environment file with: uv run icr init-secrets
# Source var/secrets.env locally; it contains ICR_KEYS, ICR_ACTIVE_KEY, ICR_TOKENS.
ICR_CONFIG=config/cpu.yaml
ICR_HOST=127.0.0.1
ICR_PORT=8000
ICR_DATA_DIR=var
ICR_MODEL_DIR=var/models/microsoft-trocr
# No provider keys/endpoints: OpenRouter and vLLM are unsupported.
